# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Project Settings > Environment Variables.

# Public site URL (used for canonical links, sitemap, email links, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Supabase (Project Settings > API Keys). Use the new key formats; legacy JWT keys are being retired.
# Publishable key (sb_publishable_...): public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). SERVER ONLY. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Spam protection: long random strings (e.g. `openssl rand -hex 32`).
FORM_TOKEN_SECRET=
RATE_LIMIT_SALT=

# Email notifications through Resend (optional; notifications are skipped when unset).
RESEND_API_KEY=
NOTIFY_EMAIL_FROM="Velez Freight Group <notifications@your-verified-domain.com>"
NOTIFY_EMAIL_TO=

# MASTER SWITCH for brokerage operations. Leave false until broker authority, BMC 84/85
# financial security and BOC 3 process agent filings are independently verified active.
# Operations also require the "Operations enabled" switch in the dashboard.
BROKER_AUTHORITY_ACTIVE=false
