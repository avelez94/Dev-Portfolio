{
  "name": "marys-logistics-group",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --conditions=react-server --experimental-strip-types --no-warnings --import ./tests/unit/alias-loader.mjs --test 'tests/unit/*.test.ts'",
    "test:db": "node --test --test-concurrency=1 tests/db/*.test.mjs",
    "test:e2e": "node tests/e2e/harness/run.mjs",
    "test": "npm run test:unit && npm run test:db",
    "preview:synthetic": "node tests/e2e/harness/preview.mjs --synthetic"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@hookform/resolvers": "^7.0.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "next": "16.2.7",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.7",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
